# Stellar testnet configuration
# Stellar CLI network alias.
STELLAR_NETWORK=testnet
# Soroban JSON-RPC endpoint.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Horizon API endpoint.
HORIZON_URL=https://horizon-testnet.stellar.org
# Network passphrase used to sign transactions.
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Deployed Soroban contract address; empty until deployment.
CONTRACT_ID=
# Soroban token contract addresses populated by scripts/setup-tokens.sh.
TOKEN_XLM_ID=
TOKEN_USDC_ID=
# Secret seed for deployment only; never commit a populated value.
DEPLOYER_SECRET=
# Optional, separate test actors for scripts/smoke-test.ts.
SMOKE_ORG_SECRET=
SMOKE_DONOR_SECRET=
SMOKE_DONOR_2_SECRET=
SMOKE_DONOR_3_SECRET=
SMOKE_VERIFIER_1_SECRET=
SMOKE_VERIFIER_2_SECRET=
# Optional issuer public key; set this to deploy a testnet USDC SAC.
USDC_ISSUER_ADDRESS=

# Backend configuration
# HTTP port for the API.
PORT=3000
# SQLite database path.
DATABASE_URL=./data/app.db
# Optional key for privileged API operations.
ADMIN_API_KEY=
# Comma-separated allowed browser origins; empty disables cross-origin access.
ALLOWED_ORIGINS=
# Global request rate limit.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Evidence upload directory (PDF/PNG/JPEG, max 10 MB).
EVIDENCE_STORAGE_DIR=./data/evidence
# Poll cadence for Soroban events; first run starts at RPC retention if unset.
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_START_LEDGER=0
